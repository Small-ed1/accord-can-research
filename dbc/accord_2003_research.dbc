CM_ "Research observations only. Unknown fields and candidates are not validated vehicle control interfaces. Read docs/protocol.md and docs/calibration.md.";
CM_ SG_ 200 Raw_B0 "unknown-or-unexcited; source 03-MAP. Unmapped region retained verbatim. May be constant or an unexercised feature; not manufacturer-reserved by inference.";
CM_ SG_ 200 Raw_B1 "unknown-or-unexcited; source 03-MAP. Unmapped region retained verbatim. May be constant or an unexercised feature; not manufacturer-reserved by inference.";
CM_ SG_ 200 Raw_B2 "unknown-or-unexcited; source 03-MAP. Unmapped region retained verbatim. May be constant or an unexercised feature; not manufacturer-reserved by inference.";
CM_ SG_ 200 Raw_B3 "unknown-or-unexcited; source 03-MAP. Unmapped region retained verbatim. May be constant or an unexercised feature; not manufacturer-reserved by inference.";
CM_ SG_ 200 SpeedB "high; source 03-V3. 2003 primary nominal speed. On 2007 about 2.06% higher than A; not an independent wheel speed. 2003 OBD-equivalent empirical alternative raw*0.0098.";
CM_ SG_ 200 DistanceTicksRaw "high; source 03-V3. Modulo 256. Approximate historical 10 m/tick. Do not import 2007 calibration automatically.";
CM_ SG_ 200 Raw_B7_bits0_5 "unknown-or-unexcited; source 03-MAP. Unmapped region retained verbatim. May be constant or an unexercised feature; not manufacturer-reserved by inference.";
CM_ SG_ 200 RollingCounter "protocol-validated; source 03-V3. Modulo 4 per identifier; discontinuity is not an exact loss count.";
CM_ SG_ 212 LightingMode "high; source 03-V3. Reported mode, not measured lamp current. DRL output is not decoded by this enum.";
VAL_ 212 LightingMode 0 "off" 1 "parking" 2 "low beam" 3 "high beam or flash";
CM_ SG_ 212 ParkingBrake "high; source 03-V3. Set=applied switch/status; not holding force.";
CM_ SG_ 212 Raw_B0_bits3_7 "unknown-or-unexcited; source 03-MAP. Unmapped region retained verbatim. May be constant or an unexercised feature; not manufacturer-reserved by inference.";
CM_ SG_ 212 Raw_B1 "unknown-or-unexcited; source 03-MAP. Unmapped region retained verbatim. May be constant or an unexercised feature; not manufacturer-reserved by inference.";
CM_ SG_ 212 Raw_B2_bits0_5 "unknown-or-unexcited; source 03-MAP. Unmapped region retained verbatim. May be constant or an unexercised feature; not manufacturer-reserved by inference.";
CM_ SG_ 212 AccessoryControlCandidate "experimental; source 03-V3. 2003 A/C-correlated behavior. 2007 asserts with fresh zero RPM for long intervals; not proof of compressor rotation, mechanical load or physical clutch engagement.";
CM_ SG_ 212 OilWarningCandidate "candidate; source 03-MAP. 2003 lifecycle-based candidate; 2007 lamp-identified. Boolean status only, never oil pressure in physical units.";
CM_ SG_ 212 FuelSenderRelatedB3 "high-related-raw; source 03-V3. Sender-related channel; angle-like interpretation historical on 2003. No confirmed tank percentage or gallons. 2007 output changes on approximately 200 ms grid.";
CM_ SG_ 212 FuelSenderRelatedB4 "high-related-raw; source 03-V3. Related inversely to B3. Historical 2003 5/255 V scaling is an approximation, not a direct voltmeter calibration; retain raw.";
CM_ SG_ 212 SecondarySpeedRaw "high-related-raw; source 03-V3. Filtered/smoothed speed-related field. Nominal raw/100 convention; fitted offsets are invalid near standstill. Not a separately decoded wheel speed.";
CM_ SG_ 212 NibbleChecksum "protocol-validated; source 03-V3. Payload nibble-sum checksum; no identifier contribution. Validate outside DBC.";
CM_ SG_ 212 Raw_B7_bits4_5 "unknown-or-unexcited; source 03-MAP. Unmapped region retained verbatim. May be constant or an unexercised feature; not manufacturer-reserved by inference.";
CM_ SG_ 212 RollingCounter "protocol-validated; source 03-V3. Modulo 4 per identifier; discontinuity is not an exact loss count.";
CM_ SG_ 300 CoolantTemperature "obd-validated; source 03-V2. 2003 independently OBD compared; 2007 prior mapping supported by traces. Frame frequency is not independent sensor update frequency.";
CM_ SG_ 300 IntakeAirTemperature "obd-validated; source 03-V2. 2003 all 93 comparisons within 1 C. Formula is approximate.";
CM_ SG_ 300 Raw_B2 "unknown-or-unexcited; source 03-MAP. Unmapped region retained verbatim. May be constant or an unexercised feature; not manufacturer-reserved by inference.";
CM_ SG_ 300 Raw_B3 "unknown-or-unexcited; source 03-MAP. Unmapped region retained verbatim. May be constant or an unexercised feature; not manufacturer-reserved by inference.";
CM_ SG_ 300 EngineRPM "obd-validated; source 03-V2. BE16 directly in rpm. Do not use the generic OBD divide-by-four rule.";
CM_ SG_ 300 ServiceBrake "high; source 03-V3. Set=service brake switch/status asserted; no brake pressure measurement.";
CM_ SG_ 300 Raw_B6_bits1_3 "unknown-or-unexcited; source 03-MAP. Unmapped region retained verbatim. May be constant or an unexercised feature; not manufacturer-reserved by inference.";
CM_ SG_ 300 MILStatus "strong-inference; source 03-MAP. Lamp command/status only. Off does not establish no pending/stored DTC. On 2007 can time out after about 20 s with engine stopped.";
CM_ SG_ 300 Raw_B6_bits5_7 "unknown-or-unexcited; source 03-MAP. Unmapped region retained verbatim. May be constant or an unexercised feature; not manufacturer-reserved by inference.";
CM_ SG_ 300 NibbleChecksum "protocol-validated; source 03-V3. Payload nibble-sum checksum; no identifier contribution. Validate outside DBC.";
CM_ SG_ 300 Raw_B7_bits4_5 "unknown-or-unexcited; source 03-MAP. Unmapped region retained verbatim. May be constant or an unexercised feature; not manufacturer-reserved by inference.";
CM_ SG_ 300 RollingCounter "protocol-validated; source 03-V3. Modulo 4 per identifier; discontinuity is not an exact loss count.";
CM_ SG_ 392 ReportedGear "high; source 03-V3. Keep selector and target alongside this field. Code 7 may persist during Reverse engagement; it is not seventh gear.";
VAL_ 392 ReportedGear 0 "Park or Neutral status; use selector" 1 "1st" 2 "2nd" 3 "3rd" 4 "4th" 5 "5th" 6 "Settled Reverse" 7 "Transition or unsettled status, not seventh gear";
CM_ SG_ 392 TargetGear "high; source 03-V3. Requested/reported target; a change is not proof of physical clutch transfer completion.";
VAL_ 392 TargetGear 0 "Park or Neutral status; use selector" 1 "1st" 2 "2nd" 3 "3rd" 4 "4th" 5 "5th" 6 "Settled Reverse";
CM_ SG_ 392 Raw_B2_bits0_6 "unknown-or-unexcited; source 03-MAP. Unmapped region retained verbatim. May be constant or an unexercised feature; not manufacturer-reserved by inference.";
CM_ SG_ 392 DRangeCandidate "candidate; source 03-V3. 2003 D-associated candidate; 2007 green D lamp including startup bulb-check in Park. Not TCC lockup or shift-interlock feedback.";
CM_ SG_ 392 SelectorCode "high; source 03-V3. Raw one-hot-like selector codes. No 0x10 position established. Unknown code is not Park.";
VAL_ 392 SelectorCode 0 "Between positions or unknown" 1 "P" 2 "R" 4 "N" 8 "D" 32 "D3" 64 "2" 128 "1";
CM_ SG_ 392 Raw_B4 "unknown-or-unexcited; source 03-MAP. Unmapped region retained verbatim. May be constant or an unexercised feature; not manufacturer-reserved by inference.";
CM_ SG_ 392 Raw_B5 "unknown-or-unexcited; source 03-MAP. Unmapped region retained verbatim. May be constant or an unexercised feature; not manufacturer-reserved by inference.";
CM_ SG_ 392 Raw_B6 "unknown-or-unexcited; source 03-MAP. Unmapped region retained verbatim. May be constant or an unexercised feature; not manufacturer-reserved by inference.";
